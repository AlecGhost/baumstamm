{
    "build": {
        "beforeBuildCommand": "cd src-react && npm run build",
        "beforeDevCommand": "cd src-react && npm start",
        "devPath": "http://localhost:3000",
        "distDir": "build",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "baumstamm-app",
        "version": "0.2.0"
    },
    "tauri": {
        "allowlist": {
            "dialog": {
                "open": true,
                "save": true
            },
            "protocol": {
                "asset": true,
                "assetScope": [
                    "**/*"
                ]
            }
        },
        "bundle": {
            "active": true,
            "category": "DeveloperTool",
            "copyright": "",
            "deb": {
                "depends": []
            },
            "externalBin": [],
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "identifier": "de.ghost",
            "longDescription": "",
            "macOS": {
                "entitlements": null,
                "exceptionDomain": "",
                "frameworks": [],
                "providerShortName": null,
                "signingIdentity": null
            },
            "resources": [],
            "shortDescription": "",
            "targets": "all",
            "windows": {
                "certificateThumbprint": null,
                "digestAlgorithm": "sha256",
                "timestampUrl": ""
            }
        },
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost"
        },
        "updater": {
            "active": false
        },
        "windows": [
            {
                "fullscreen": false,
                "height": 600,
                "resizable": true,
                "title": "Baumstamm",
                "width": 800
            }
        ]
    }
}
